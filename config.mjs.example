export const config = {
  // prefix log lines with an ISO timestamp (off by default; journald adds its own)
  logTimestamps: true,
  // seconds between per-radio stats lines (default 30, 0 disables)
  statsInterval: 30,
  // log received GRP_TXT (channel) messages, decrypted with debugChannels
  debug: true,
  // channels to decrypt in debug output: '#hashtag', or { name, key: '<32 hex chars>' }
  debugChannels: [
    { name: 'Public', key: '8b3387e9c5cdea6ac9e5edbaa115cd72' },
    '#cs',
  ],
  radios: [
    {
      name: 'CZ',
      port: '/dev/cu.usbmodem101',
      freq: 869.432,
      bw: 62.5,
      sf: 7,
      cr: 5,
      txPower: 22,
    },
    {
      name: 'SK',
      port: '/dev/cu.usbmodemF09E9E7747081',
      freq: 869.618,
      bw: 62.5,
      sf: 7,
      cr: 5,
      txPower: 22,
      // optional: report every packet this radio hears (with SNR/RSSI) to MQTT,
      // meshcoretomqtt format; can also be an array to report to several brokers
      // mqtt: {
      //   url: 'mqtts://mqtt.example.com:8883',
      //   username: 'user',
      //   password: 'secret',
      //   iata: 'BTS',              // location code used in the topic
      //   name: 'SK forwarder',     // "origin" in reports (default: radio name)
      //   rejectUnauthorized: true, // false = don't verify the TLS certificate
      // },
      // or, for brokers using meshcoretomqtt token auth (signed by the modem's key):
      // mqtt: { url: 'wss://mqtt-eu-v1.letsmesh.net:443', auth: 'token', iata: 'BTS' },
    },
  ],
  // forward all non-flood packets, but only flood packets scoped to region #cs
  filter(packet, constants) {
    if (!packet.isFlood) return true;
    return packet.isInRegion('#cs') || (packet.type === constants.GRP_TXT && (packet.isFromChannel('#cs') || packet.isFromChannel('#hamradio')));
  }
};
