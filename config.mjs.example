export const config = {
  // prefix log lines with an ISO timestamp (off by default; journald adds its own)
  logTimestamps: true,
  // log received GRP_TXT (channel) messages, decrypted with debugChannels
  debug: true,
  // channels to decrypt in debug output: '#hashtag', or { name, key: '<32 hex chars>' }
  debugChannels: [
    { name: 'Public', key: '8b3387e9c5cdea6ac9e5edbaa115cd72' },
    '#cs',
  ],
  radios: [
    {
      name: 'CZ',
      port: '/dev/cu.usbmodem101',
      freq: 869.432,
      bw: 62.5,
      sf: 7,
      cr: 5,
      txPower: 22,
    },
    {
      name: 'SK',
      port: '/dev/cu.usbmodemF09E9E7747081',
      freq: 869.618,
      bw: 62.5,
      sf: 7,
      cr: 5,
      txPower: 22,
    },
  ],
  // forward all non-flood packets, but only flood packets scoped to region #cs
  filter(packet, constants) {
    if (!packet.isFlood) return true;
    return packet.isInRegion('#cs') || (packet.type === constants.GRP_TXT && (packet.isFromChannel('#cs') || packet.isFromChannel('#hamradio')));
  }
};
